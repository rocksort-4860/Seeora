{
  "expo": {
    "name": "Seeora",
    "slug": "seeora",
    "scheme": "seeora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "bundleIdentifier": "com.seeora.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": true,
        "LSApplicationQueriesSchemes": [
          "mailto"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F4"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.seeora.app",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#2d7a6b"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Seeora 访问相册，用于为分享卡片添加图片 / Allow Seeora to access your photos to attach images to your share card.",
          "cameraPermission": "允许 Seeora 使用相机拍摄分享图片 / Allow Seeora to use the camera to take photos for sharing."
        }
      ],
      "expo-file-system",
      "@react-native-async-storage/expo-with-async-storage",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1242,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F4"
        }
      ],
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "./plugins/crashReason/withCrashReason",
      "./plugins/turboModuleFix/withTurboModuleFix",
      "./plugins/withFmtConstevalFix",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "90f7b491-bd46-4c0a-b470-0045fccfa598"
      }
    },
    "owner": "seeora"
  }
}
