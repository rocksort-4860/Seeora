{
  "expo": {
    "name": "Seeora",
    "slug": "seeora",
    "scheme": "seeora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "appleTeamId": "ZFVWH8644U",
      "supportsTablet": false,
      "buildNumber": "13",
      "bundleIdentifier": "com.seeora.app",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.seeora.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "mailto"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF9F4"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "package": "com.seeora.app",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-system-ui",
      "expo-image",
      "@bacons/apple-targets",
      [
        "expo-notifications",
        {
          "color": "#2d7a6b"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许 Seeora 访问你的相册，用于把成就卡片保存为图片 / Allow Seeora to access your photos to save achievement cards as images.",
          "savePhotosPermission": "允许 Seeora 把成就卡片保存到你的相册 / Allow Seeora to save achievement cards to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-file-system",
      "@react-native-async-storage/expo-with-async-storage",
      "expo-sharing",
      "expo-document-picker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1242,
          "resizeMode": "contain",
          "backgroundColor": "#FAF9F4"
        }
      ],
      [
        "expo-router",
        {
          "root": "src/app"
        }
      ],
      "./plugins/crashReason/withCrashReason",
      "./plugins/turboModuleFix/withTurboModuleFix",
      "./plugins/withFmtConstevalFix",
      "./plugins/withExpoModulesCoreWerrorFix",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "autolinking": {
      "ios": {
        "buildFromSource": [
          "react-native-reanimated",
          "react-native-worklets"
        ]
      }
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "90f7b491-bd46-4c0a-b470-0045fccfa598"
      }
    },
    "owner": "seeora"
  }
}
