# ⚠️ 这是 Seeora 专用配置模板，请填入你自己在 RevenueCat 后台「Seeora」应用下的值。
# 不要用 Streakora 的 key（那是另一个项目，已清掉）。
# 复制本文件为 .env 后填写；.env 已被 .gitignore 忽略，不会进版本库，安全。

# 非必需，可留空
EXPO_PUBLIC_APP_ID=

# RevenueCat iOS 公开 API Key
# 来源：RC 后台 → Seeora 应用 → App Settings → API Keys → 复制 iOS 那一条
EXPO_PUBLIC_REVENUECAT_IOS_KEY=

# 兼容别名（iap.ts 同时认这个变量名）
EXPO_PUBLIC_RC_IOS_KEY=
